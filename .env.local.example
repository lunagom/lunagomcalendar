# ┌──────────────────────────────────────────────────────────────────────────┐
# │ 루나곰 캘린더 환경 변수 템플릿                                          │
# │                                                                          │
# │ 사용법: 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.            │
# │   PowerShell:  Copy-Item .env.local.example .env.local                   │
# │                                                                          │
# │ .env.local 은 .gitignore 에 포함되어 있어 커밋되지 않습니다.             │
# └──────────────────────────────────────────────────────────────────────────┘

# Supabase — 프로젝트 설정 > API 에서 복사
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# 서비스 롤 키 — 절대 브라우저로 노출 금지 (서버 액션/Route Handler에서만 사용)
# 관리자 작업, 시드 스크립트 등에 사용
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase 프로젝트 ID — `pnpm db:types` 가 사용
# 예: ablkqwxyzpqrstuv (URL의 https://<여기>.supabase.co)
SUPABASE_PROJECT_ID=your-project-id

# 소셜 로그인(카카오/구글) 버튼 노출 토글.
# "true" 일 때만 로그인/회원가입 페이지에 버튼이 보임.
# 카카오/구글 OAuth 가 Supabase 와 각 콘솔에 모두 등록된 환경에서만 켜기.
# 비워두면 이메일 로그인만 보임.
NEXT_PUBLIC_SOCIAL_AUTH_ENABLED=

# 카카오 로그인 개별 토글. 검수 / 비즈앱 통과 후 "true" 로.
# 일반앱 상태에서는 account_email scope 권한 거부로 KOE205 발생.
NEXT_PUBLIC_KAKAO_ENABLED=

# Sentry — sentry.io 프로젝트 생성 후 채움. prod 만 채우면 됨 (dev 는 비워둬도 SDK no-op).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel Cron 보호용 (Vercel 콘솔에서 무작위 32자 생성 → 등록).
# 로컬에서는 비워둠 — keepalive 라우트 자체가 비어있으면 401 반환하므로 안전.
CRON_SECRET=
